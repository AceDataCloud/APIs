{
  "openapi": "3.0.1",
  "info": {
    "title": "AceData_Digital_Human_Studio",
    "version": "2.0.0",
    "description": "Create a talking-avatar video from authorized visual and audio or text inputs. Manage supported voices and retrieve completed tasks. Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples. Start: https://platform.acedata.cloud/services/5b132265-40e8-4a79-9582-589f8eea4733?from=coze"
  },
  "servers": [
    {
      "url": "https://api.acedata.cloud"
    }
  ],
  "paths": {
    "/digital-human/videos": {
      "post": {
        "summary": "Digital Human video generation API — turn a portrait plus audio or text into a talking-head video.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string"
                    },
                    "width": {
                      "type": "integer"
                    },
                    "engine": {
                      "type": "string"
                    },
                    "height": {
                      "type": "integer"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "task_id": {
                      "type": "string"
                    },
                    "duration": {
                      "type": "number",
                      "format": "double"
                    },
                    "trace_id": {
                      "type": "string"
                    },
                    "video_url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Balance"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Rate limit"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Server error"
          }
        },
        "operationId": "generateVideo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Spoken text -> TTS (requires voice_id)."
                  },
                  "async": {
                    "type": "boolean",
                    "default": true
                  },
                  "speed": {
                    "type": "number",
                    "default": 1.0,
                    "description": "Audio tempo multiplier."
                  },
                  "steps": {
                    "type": "integer",
                    "default": 40,
                    "description": "Diffusion steps (LatentSync)."
                  },
                  "engine": {
                    "enum": [
                      "latentsync",
                      "heygem"
                    ],
                    "type": "string",
                    "default": "latentsync",
                    "deprecated": true,
                    "description": "[Deprecated] Accepted for backward compatibility but no longer changes the output or the price — every request is billed at the unified rate."
                  },
                  "guidance": {
                    "type": "number",
                    "default": 2.0,
                    "description": "Lip-sync strength (LatentSync). Lower loosens sync."
                  },
                  "seam_fix": {
                    "type": "boolean",
                    "default": true,
                    "description": "Apply the mouth-seam reduction blend."
                  },
                  "voice_id": {
                    "type": "string",
                    "description": "A cloned voice from POST /digital-human/voices."
                  },
                  "audio_url": {
                    "type": "string",
                    "description": "Public URL of the driving audio (.wav/.mp3/.m4a). OR supply text(+voice_id)."
                  },
                  "image_url": {
                    "type": "string",
                    "description": "Public URL of a source face photo (photo-driven path). Supply either video_url or image_url."
                  },
                  "video_url": {
                    "type": "string",
                    "description": "Public URL of the source face video (preferred). Supply either video_url or image_url."
                  },
                  "resolution": {
                    "enum": [
                      "720p",
                      "540p"
                    ],
                    "type": "string",
                    "default": "720p",
                    "deprecated": true,
                    "description": "[Deprecated] Output is always rendered at 720p."
                  },
                  "callback_url": {
                    "type": "string",
                    "description": "Webhook; if set (or async=true) returns task_id immediately."
                  }
                }
              }
            }
          },
          "required": true
        },
        "description": "Digital Human video generation API — turn a portrait plus audio or text into a talking-head video. Full input requirements: https://platform.acedata.cloud/documents/digitalhuman-videos Submit once with async=true. Retain task_id and poll the matching task tool; a task ID is not a completed result. Do not resubmit while pending.",
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/digitalhuman-videos"
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/digital-human/tasks": {
      "post": {
        "summary": "Digital Human task query API — check the status and result of a talking-head video or voice-clone task.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "task_id",
                    "trace_id",
                    "state",
                    "progress"
                  ],
                  "properties": {
                    "state": {
                      "type": "string",
                      "description": "Current task state."
                    },
                    "width": {
                      "type": "number",
                      "description": "Generated video width in pixels."
                    },
                    "engine": {
                      "type": "string",
                      "description": "Rendering engine selected for the task."
                    },
                    "height": {
                      "type": "number",
                      "description": "Generated video height in pixels."
                    },
                    "success": {
                      "type": "boolean",
                      "description": "Whether the task query succeeded."
                    },
                    "task_id": {
                      "type": "string",
                      "description": "Asynchronous task identifier."
                    },
                    "duration": {
                      "type": "number",
                      "description": "Length of the generated video in seconds — not the task's processing time."
                    },
                    "progress": {
                      "type": "number",
                      "description": "Completion percentage from 0 to 100."
                    },
                    "trace_id": {
                      "type": "string",
                      "description": "Request trace identifier."
                    },
                    "video_url": {
                      "type": "string",
                      "format": "uri",
                      "description": "Generated video URL when available."
                    }
                  },
                  "description": "The flat poll shape returned when `action` is omitted. Send `action: retrieve` to additionally receive created_at / started_at / finished_at / elapsed — all Unix timestamps in seconds (float); started_at / finished_at / elapsed are null until the task is claimed / finished."
                }
              }
            },
            "description": "OK"
          }
        },
        "operationId": "getTaskResults",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id"
                ],
                "properties": {
                  "action": {
                    "enum": [
                      "retrieve",
                      "retrieve_batch"
                    ],
                    "type": "string",
                    "description": "Omit for the flat poll shape. Use `retrieve` for the detailed shape, which additionally carries created_at / started_at / finished_at / elapsed."
                  },
                  "task_id": {
                    "type": "string",
                    "description": "Asynchronous digital-human task identifier."
                  }
                }
              }
            }
          },
          "required": true
        },
        "description": "Digital Human task query API — check the status and result of a talking-head video or voice-clone task. Full input requirements: https://platform.acedata.cloud/documents/digitalhuman-tasks A non-null response can be a progress snapshot. Require terminal success and a non-empty primary media URL or content, not just a cover image or an empty data array.",
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/digitalhuman-tasks"
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/digital-human/voices": {
      "post": {
        "summary": "Digital Human voice-clone API — upload an audio sample to clone a custom voice for speech synthesis.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "task_id": {
                      "type": "string"
                    },
                    "trace_id": {
                      "type": "string"
                    },
                    "voice_id": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Bad request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Server error"
          }
        },
        "operationId": "createVoice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "audio_url"
                ],
                "properties": {
                  "lang": {
                    "enum": [
                      "zh",
                      "en"
                    ],
                    "type": "string",
                    "default": "zh"
                  },
                  "name": {
                    "type": "string",
                    "description": "Optional label."
                  },
                  "async": {
                    "type": "boolean",
                    "default": true
                  },
                  "audio_url": {
                    "type": "string",
                    "description": "Public URL of a clean 10-20s voice sample."
                  }
                }
              }
            }
          },
          "required": true
        },
        "description": "Digital Human voice-clone API — upload an audio sample to clone a custom voice for speech synthesis. Full input requirements: https://platform.acedata.cloud/documents/digitalhuman-voices Submit once with async=true. Retain task_id and poll the matching task tool; a task ID is not a completed result. Do not resubmit while pending.",
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/digitalhuman-voices"
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  }
}
