        ],
        "description": "Search the web and return structured results, including web pages, images, news, maps, locations, or video queries. Full input requirements: https://platform.acedata.cloud/documents/serp-google",
        "operationId": "searchGoogle",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "oneOf": [
                  {
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "images"
                        ],
                        "type": "string"
                      }
                    }
                  },
                  {
                    "not": {
                      "required": [
                        "image_size"
                      ]
                    },
                    "properties": {
                      "type": {
                        "enum": [
                          "search",
                          "news",
                          "maps",
                          "places",
                          "videos"
                        ],
                        "type": "string"
                      }
                    }
                  }
                ],
                "required": [
                  "query"
                ],
                "properties": {
                  "page": {
                    "type": "integer",
                    "default": 1,
                    "maximum": 100,
                    "minimum": 1,
                    "description": "The page number of the search results is set to page 1 by default."
                  },
                  "type": {
                    "enum": [
                      "search",
                      "images",
                      "news",
                      "maps",
                      "places",
                      "videos"
                    ],
                    "type": "string",
                    "default": "search",
                    "description": "Search resource type parameters currently support six types: `search` (web search), `images` (images), `news` (news), `maps` (maps), `places` (places), `videos` (videos). The default value is `search`."
                  },
                  "query": {
                    "type": "string",
                    "pattern": ".*\\S.*",
                    "maxLength": 2048,
                    "minLength": 1,
                    "description": "Search query keywords."
                  },
                  "range": {
                    "enum": [
                      "h",
                      "d",
                      "w",
                      "m",
                      "y",
                      "qdr:h",
                      "qdr:d",
                      "qdr:w",
                      "qdr:m",
                      "qdr:y"
                    ],
                    "type": "string",
                    "description": "Time range filter for search results, no time limit by default."
                  },
                  "number": {
                    "type": "integer",
                    "default": 3,
                    "maximum": 100,
                    "minimum": 1,
                    "description": "The number of search results returned is 10 by default."
                  },
                  "country": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 1,
                    "description": "The country/region code used by the search engine is `US` (United States) by default."
                  },
                  "language": {
                    "type": "string",
                    "maxLength": 32,
                    "minLength": 1,
                    "description": "The language code used by the search engine is `en` (English) by default."
                  },
                  "image_size": {
                    "enum": [
                      "large",
                      "medium",
                      "icon",
                      "2mp",
                      "4mp",
                      "6mp",
                      "8mp",
                      "10mp",
                      "12mp",
                      "15mp",
                      "20mp",
                      "40mp",
                      "70mp"
                    ],
                    "type": "string",
                    "description": "Image size filtering conditions are only valid when `type` is `images`."
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/serp-google"
        }
