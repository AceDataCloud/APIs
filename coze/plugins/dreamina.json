                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Unauthorized, authorization token is invalid or missing."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Access denied, insufficient balance or exceeded quota limit."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Too many requests, rate limit exceeded."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "description": "Internal server error, an exception occurred on the server side."
          }
        },
        "description": "Generate an audio-driven \"talking photo\" digital human video (OmniHuman 1.5). Provide a portrait image and a segment of driving audio, and the person in the image can synchronize their speech with the audio. Full input requirements: https://platform.acedata.cloud/documents/dreamina-videos Submit once with async=true. Retain task_id and poll the matching task tool; a task ID is not a completed result. Do not resubmit while pending.",
        "operationId": "post__dreamina_videos",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "image_url",
                  "audio_url"
                ],
                "properties": {
                  "async": {
                    "type": "boolean",
                    "description": "If set to true, the request will immediately return task_id without the need to provide callback_url; results can be obtained by polling the corresponding tasks interface.",
                    "default": true
                  },
                  "model": {
                    "enum": [
                      "omnihuman-1.5"
                    ],
                    "type": "string",
                    "default": "omnihuman-1.5",
                    "description": "The model being used is OmniHuman 1.5."
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Optional text prompts for guiding expressions, emotions, stability, and style."
                  },
                  "mask_url": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "description": "Optional subject mask URL (from object detection) to specify and drive a particular person in a multi-person image."
                  },
                  "audio_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public URL for audio (mp3/wav). The character will lip-sync to it, and it is recommended that the duration be controlled within 60 seconds."
                  },
                  "image_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public URL of portrait images. Clear frontal face effects are best."
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "If provided, the request will immediately return task_id, and the result will be pushed to that URL once ready."
                  }
                }
              }
            }
          },
          "required": true
        },
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/dreamina-videos"
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples.",
            "schema": {
              "type": "string"
            }
          }
        ]
