        "description": "Query the results of the Dreamina digital human video generation task. Use the task_id or trace_id returned when creating the task for the query; this interface is free. Full input requirements: https://platform.acedata.cloud/documents/dreamina-tasks A non-null response can be a progress snapshot. Require terminal success and a non-empty primary media URL or content, not just a cover image or an empty data array.",
        "operationId": "post__dreamina_tasks",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The task ID to be queried (i.e., the task_id returned when creating the video)."
                  },
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "A list of task IDs for batch querying, to be used with `retrieve_batch`."
                  },
                  "action": {
                    "enum": [
                      "retrieve",
                      "retrieve_batch"
                    ],
                    "type": "string",
                    "default": "retrieve",
                    "description": "Operation type. Use `retrieve` to query a single task, and use `retrieve_batch` to query multiple tasks in bulk."
                  },
                  "trace_id": {
                    "type": "string",
                    "description": "The tracking ID of the task to be queried (i.e., the trace_id returned when creating the video) can be used instead of the id."
                  }
                }
              }
            }
          },
          "required": true
        },
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/dreamina-tasks"
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/dreamina/videos": {
      "post": {
        "summary": "Audio-driven talking-photo digital human video generation (OmniHuman 1.5)",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "description": "Generate status, for example `done` indicates generation is complete."
                        },
                        "task_id": {
                          "type": "string",
                          "description": "The unique ID of this task, which can be used to obtain the processing results of the asynchronous task through the corresponding task query interface."
                        },
                        "audio_url": {
                          "type": "string",
                          "description": "Used to drive the generated audio URL (i.e., the audio provided at the time of the request)"
                        },
                        "image_url": {
                          "type": "string",
                          "description": "The source image URL used for driving generation (i.e., the image provided at the time of the request)"
                        },
                        "video_url": {
                          "type": "string",
                          "description": "URL of the generated digital human video file"
                        }
                      },
                      "description": "The result data returned from this request"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "A flag indicating whether this request was successful."
                    },
                    "task_id": {
                      "type": "string",
                      "description": "The unique ID of this task, which can be used to obtain the processing results of the asynchronous task through the corresponding task query interface."
                    },
                    "trace_id": {
                      "type": "string",
                      "description": "The tracking ID for this request, used for issue troubleshooting."
                    }
                  }
                }
              }
            },
            "description": "Request successful."
          },
