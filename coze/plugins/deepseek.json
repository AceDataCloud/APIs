                          "description": "The tracking ID for this request."
                        }
                      }
                    }
                  ],
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Response error code."
                        },
                        "message": {
                          "type": "string",
                          "description": "Error message of the response."
                        }
                      }
                    },
                    "trace_id": {
                      "type": "string",
                      "description": "The tracking ID for this request."
                    }
                  }
                }
              }
            },
            "description": "Internal server error, an exception occurred on the server."
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "accept",
            "schema": {
              "enum": [
                "application/json",
                "application/x-ndjson"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Specify the response format returned by the server."
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "operationId": "createConversation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "question",
                  "model"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The unique identifier for the conversation, which can be used to continue an existing dialogue."
                  },
                  "model": {
                    "enum": [
                      "deepseek-r1",
                      "deepseek-r1-0528",
                      "deepseek-v3",
                      "deepseek-v3-250324",
                      "deepseek-v4.1-flash",
                      "deepseek-v4-flash",
                      "deepseek-v4-pro"
                    ],
                    "type": "string",
                    "description": "The name of the large language model used to answer prompt words.",
                    "default": "deepseek-v4-flash"
                  },
                  "preset": {
                    "type": "string",
                    "description": "Preset system prompts or dialogue configurations used to customize the model's response style and behavior."
                  },
                  "question": {
                    "type": "string",
                    "description": "Prompts or questions for the model to respond to."
                  },
                  "stateful": {
                    "type": "boolean",
                    "description": "Whether to enable stateful conversation mode. Once enabled, the server will retain conversation history to support multi-turn continuous dialogue."
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "A list of reference materials or sources to assist the model in answering, such as URLs or text excerpts from relevant documents."
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "description": "Use the public AI Dialogue conversation API with an explicitly selected DeepSeek model. https://platform.acedata.cloud/documents/aichat-conversations",
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/aichat-conversations"
        }
      }
    }
  }
}
