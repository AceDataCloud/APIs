    "title": "Fish",
    "version": "2.0.0",
    "description": "Turn text into speech, browse supported saved voices, or create a voice from authorized reference audio. Retrieve asynchronous speech tasks. Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples. Start: https://platform.acedata.cloud/services/caf99abc-ddcf-4714-b2a5-862d9b469509?from=coze"
  },
  "servers": [
    {
      "url": "https://api.acedata.cloud"
    }
  ],
