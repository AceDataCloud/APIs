        },
        "parameters": [
          {
            "in": "header",
            "name": "accept",
            "schema": {
              "enum": [
                "application/json"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Specify the response format returned by the server."
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "description": "Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "operationId": "translateContent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "extension",
                  "input",
                  "locale"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "description": "Markdown or plain text to translate."
                  },
                  "model": {
                    "enum": [
                      "gpt-3.5",
                      "gpt-4"
                    ],
                    "type": "string",
                    "description": "The large language model used for translation is `gpt-3.5` by default."
                  },
                  "locale": {
                    "enum": [
                      "en",
                      "de",
                      "pt",
                      "es",
                      "fr",
                      "zh-CN",
                      "zh-TW",
                      "it",
                      "ko",
                      "ja",
                      "ru",
                      "pl",
                      "fi",
                      "sv",
                      "el",
                      "uk",
                      "ar",
                      "sr"
                    ],
                    "type": "string",
                    "description": "The target language area to be translated to."
                  },
                  "extension": {
                    "enum": [
                      "md"
                    ],
                    "type": "string",
                    "default": "md",
                    "description": "The file type of the input text (such as `json` or `md`)."
                  }
                }
              }
            }
          },
          "required": true
        },
        "description": "Translate a JSON input into any localized file Full input requirements: https://platform.acedata.cloud/documents/localization-translate This Coze form translates Markdown/plain text only; JSON-object translation is retained in the canonical API contract.",
        "externalDocs": {
          "url": "https://platform.acedata.cloud/documents/localization-translate"
        }
      }
    }
  }
