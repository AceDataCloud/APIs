{
  "openapi": "3.0.1",
  "info": {
    "title": "Localization",
    "version": "2.0.0",
    "description": "Translate localization content into a target locale while specifying the source format. Review the returned translation before release. Bind your own Ace Data Cloud credential privately as Bearer YOUR_API_TOKEN in Authorization. Usage is billed to your account. Never place a token in chat or shared examples. Start: https://platform.acedata.cloud/services/bd4eaf26-4efe-4904-a045-8b83ed56f885?from=coze"
  },
  "servers": [
    {
      "url": "https://api.acedata.cloud"
    }
  ],
  "paths": {
    "/localization/translate": {
      "post": {
        "summary": "Translate a JSON input into any localized file",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "description": "Translated Markdown or plain text."
                    },
                    "model": {
                      "type": "string",
                      "description": "The large language model used for this translation."
                    },
                    "locale": {
                      "type": "string",
                      "description": "The target language area for this translation."
                    }
                  }
                }
              }
            },
            "description": "Request successful, the input content has been translated into the target language."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
