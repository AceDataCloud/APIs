                            }
                          }
                        },
                        "trace_id": {
                          "type": "string",
                          "description": "The tracking ID for this request."
                        }
                      }
                    }
                  ],
                  "type": "object",
                  "properties": {
                    "error": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "description": "Response error code."
                            },
